{
  "name": "dsh-shot-ocr",
  "version": "1.0.0",
  "description": "Screenshot the desktop with a hotkey, recognise its text, and drop it into the DeepSeek Harness message box.",
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "scripts/*.ps1",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "screenshot",
    "ocr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baibaiyi/dsh-shot-ocr.git"
  },
  "homepage": "https://github.com/baibaiyi/dsh-shot-ocr#readme",
  "bugs": {
    "url": "https://github.com/baibaiyi/dsh-shot-ocr/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
